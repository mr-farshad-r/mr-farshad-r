---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {% assign seo_pages = site.pages | where_exp: "item", "item.sitemap != false" %}
  {% for item in seo_pages %}
    {% if item.url and item.url != '/404.html' %}
  <url>
    <loc>{{ item.url | absolute_url | xml_escape }}</loc>
    {% if item.en_url and item.fa_url %}
    <xhtml:link rel="alternate" hreflang="en" href="{{ item.en_url | absolute_url | xml_escape }}" />
    <xhtml:link rel="alternate" hreflang="fa" href="{{ item.fa_url | absolute_url | xml_escape }}" />
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ item.en_url | absolute_url | xml_escape }}" />
    {% endif %}
    {% if item.last_modified_at %}<lastmod>{{ item.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
    {% endif %}
  {% endfor %}
  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
</urlset>
